# Template per le variabili d'ambiente del progetto.
# Per usarlo: copia questo file in `.env` e adatta i valori.
#
#   cp .env.example .env
#
# Il file `.env` non deve essere versionato su Git.

# Cartella base usata da crawl4ai per cache, log e database.
# Lasciare vuoto per usare la root del progetto.
CRAWL4_AI_BASE_DIRECTORY=

# Modello LLM locale usato per la generazione RAG tramite Ollama.
OLLAMA_MODEL=llama3.2:1b

# Endpoint HTTP locale di Ollama.
OLLAMA_ENDPOINT=http://localhost:11434/api/generate

# Numero di chunk recuperati dal retrieval e passati al modello.
RAG_FINAL_K=3

# Lunghezza massima del contesto passato all'LLM.
RAG_MAX_CONTEXT_CHARS=3500