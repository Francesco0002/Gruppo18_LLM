# Template per le variabili d'ambiente del progetto.
# Per usarlo: copia in `.env` e adatta i valori.
#
#   cp .env.example .env
#
# Il file .env è in .gitignore: non finirà in git.

# Cartella base usata da crawl4ai per cache, log e database.
# Lasciare vuoto per usare la root del progetto, scelta consigliata per
# mantenere cache e database locali alla repo durante lo sviluppo.
# Per usare un path diverso:
#   CRAWL4_AI_BASE_DIRECTORY=/percorso/assoluto/cache-crawl4ai
CRAWL4_AI_BASE_DIRECTORY=

# Modello LLM locale usato per la generazione RAG.
#OLLAMA_MODEL=llama3.2:3b
#OLLAMA_MODEL=lfm2.5-thinking:1.2b #non va bene

# Endpoint HTTP locale di Ollama.
#OLLAMA_ENDPOINT=http://localhost:11434/api/generate

# Modello LLM Groq
GROQ_API_KEY=REPLACE_WITH_GROQ_API_KEY
GROQ_MODEL=qwen/qwen3-32b
GROQ_TIMEOUT_SECONDS=60
GROQ_MAX_RETRIES=3
GROQ_SDK_MAX_RETRIES=0
GROQ_JSON_MODE=true
GROQ_MAX_COMPLETION_TOKENS=1200
GROQ_REASONING_FORMAT=hidden
# Lasciare vuoto per usare il reasoning normale del modello, nascondendolo dalla UI.
GROQ_REASONING_EFFORT=

# Numero di chunk finali passati al modello.
RAG_FINAL_K=10

# Lunghezza massima del contesto passato all'LLM.
RAG_MAX_CONTEXT_CHARS=12000

# Budget minimo usato solo nei retry automatici quando Groq rifiuta un payload troppo grande.
RAG_MIN_CONTEXT_CHARS_ON_PAYLOAD_RETRY=3200

# Retrieval locale
EMBEDDING_MODEL=ibm-granite/granite-embedding-97m-multilingual-r2
EMBEDDING_FALLBACK_MODEL=BAAI/bge-m3
EMBEDDING_BACKEND=torch
EMBEDDING_ONNX_MODEL_PATH=
EMBEDDING_ONNX_PROVIDER=CPUExecutionProvider
EMBEDDING_ONNX_FILE_NAME=
EMBEDDING_TRUNCATE_DIM=
EMBEDDING_MAX_SEQ_LENGTH=1024
EMBEDDING_BATCH_SIZE=16
EMBEDDING_DEVICE=auto
EMBEDDING_ALLOW_FALLBACK=false
EMBEDDING_TRUST_REMOTE_CODE=true
VECTORSTORE_BATCH_SIZE=256
VECTORSTORE_ALLOW_STALE=false
DENSE_INDEX_PROFILE=core
DENSE_PDF_MIN_YEAR=2019
DENSE_MAX_CHUNKS_PER_PDF=32
DENSE_INCLUDE_RECENT_PDFS=true
DENSE_INCLUDE_REGULATION_PDFS=true
DENSE_INCLUDE_BANDO_PDFS=true

RETRIEVAL_BM25_K=80
RETRIEVAL_DENSE_K=80
RETRIEVAL_RERANK_K=20

RERANKER_ENABLED=false
RERANKER_MODEL=mixedbread-ai/mxbai-rerank-base-v2
RERANKER_FALLBACK_MODEL=cross-encoder/mmarco-mMiniLMv2-L12-H384-v1
RERANKER_WEIGHT=0.60
HYBRID_WEIGHT=0.40
RERANKER_DEVICE=auto
RERANKER_BATCH_SIZE=1
RERANKER_ALLOW_FALLBACK=false
RERANKER_TRUST_REMOTE_CODE=true

HF_TOKEN=REPLACE_WITH_HUGGINGFACE_TOKEN
